{
  "uid": "job-scheduler",
  "title": "Job Scheduler",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Throughput: jobs processed / s by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(jobs_processed_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Jobs created / s by queue",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(jobs_created_total[1m]))",
          "legendFormat": "{{queue}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(jobs_rejected_total[1m]))",
          "legendFormat": "rejected: {{reason}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Queue backlog (not yet delivered)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, lane) (queue_lag)",
          "legendFormat": "{{queue}}/{{lane}}"
        },
        {
          "refId": "B",
          "expr": "max by (state) (outbox_backlog)",
          "legendFormat": "outbox {{state}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "In progress / delayed / DLQ",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (queue_pending)",
          "legendFormat": "pending {{queue}}"
        },
        {
          "refId": "B",
          "expr": "max by (queue) (queue_delayed)",
          "legendFormat": "delayed {{queue}}"
        },
        {
          "refId": "C",
          "expr": "max by (queue) (queue_dlq_length)",
          "legendFormat": "dlq {{queue}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Queue latency (enqueue -> start)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(job_queue_latency_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(job_queue_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Handler duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, type) (rate(job_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{type}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, type) (rate(job_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 {{type}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Recovery events / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jobs_reclaimed_total[1m]))",
          "legendFormat": "reclaimed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(job_lease_lost_total[1m]))",
          "legendFormat": "lease lost"
        },
        {
          "refId": "C",
          "expr": "sum by (status) (rate(sweeper_requeued_total[5m]))",
          "legendFormat": "sweeper {{status}}"
        },
        {
          "refId": "D",
          "expr": "sum by (reason) (rate(jobs_skipped_total[1m]))",
          "legendFormat": "skipped {{reason}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Worker jobs in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "worker_jobs_in_flight",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "API latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_request_duration_seconds_bucket{service=\"api\"}[1m])))",
          "legendFormat": "p99 {{route}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "API requests / s by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{service=\"api\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 10
    }
  ],
  "tags": [
    "scheduler"
  ]
}